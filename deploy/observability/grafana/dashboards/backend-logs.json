{
  "uid": "money-space-backend-logs",
  "title": "Backend logs",
  "tags": [
    "money-space",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": {
          "label": "env",
          "refId": "env",
          "type": 1
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "debug,info,warn,error,fatal",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service_name=\"backend\", env=~\"$env\"} [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors (window)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"backend\", env=~\"$env\", level=\"error\"} [$__auto]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests by status class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (count_over_time({service_name=\"backend\", env=~\"$env\"} | json | res_statusCode != \"\" | label_format class=`{{div .res_statusCode 100}}xx` [$__auto]))",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Response time p50 / p95 / p99 (ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.50, {service_name=\"backend\", env=~\"$env\"} | json | unwrap responseTime [$__auto])",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {service_name=\"backend\", env=~\"$env\"} | json | unwrap responseTime [$__auto])",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "quantile_over_time(0.99, {service_name=\"backend\", env=~\"$env\"} | json | unwrap responseTime [$__auto])",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Slowest routes (p95 ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "topk(10, quantile_over_time(0.95, {service_name=\"backend\", env=~\"$env\"} | json | handler != \"\" | unwrap responseTime [$__range]) by (handler))"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top error messages",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "topk(10, sum by (msg) (count_over_time({service_name=\"backend\", env=~\"$env\", level=\"error\"} | json [$__range])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Live logs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"backend\", env=~\"$env\", level=~\"$level\"}"
        }
      ]
    }
  ]
}