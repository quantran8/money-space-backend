# Copied to the VM as deploy/.env.alloy by the deploy workflow. This file is the
# local-dev template — copy it to .env.alloy (gitignored) to run
# `docker compose --profile logs up` against a real Grafana Cloud stack.
#
# All three values are on one page in the Grafana Cloud portal:
#   Home > Connections > Loki > Send logs
#
# A dedicated file, not the app's .env: Alloy ships data to a third party and
# has no business holding the Supabase service-role key.

# The push endpoint of your stack's Loki. Region-specific — copy it, do not
# guess the number.
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push

# The NUMERIC stack/user id from that same page. Not an email address: an email
# authenticates against the portal but gets a 401 from the push endpoint, which
# is the single most common way this comes up broken.
GRAFANA_CLOUD_LOKI_USER=123456

# An access-policy token with the `logs:write` scope. Starts with `glc_`.
# Generate under Administration > Users and access > Access policies.
GRAFANA_CLOUD_LOKI_TOKEN=glc_replace_me
